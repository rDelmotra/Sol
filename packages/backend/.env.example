PORT=3001
NODE_ENV=development

# Space-Track credentials — the PRIMARY GP (orbital elements) source for the
# full ~32k-object catalog. Without them the server falls back to CelesTrak,
# which serves far fewer objects. Register free at
# https://www.space-track.org/auth/createAccount
SPACETRACK_USER=your_spacetrack_username
SPACETRACK_PASS=your_spacetrack_password

# Directory where tle-cache.json and version.json are written (relative to cwd)
CACHE_DIR=./data

# CORS — keep "*" for public deployment; restrict to your frontend domain in production
CORS_ORIGIN=*

# ── Optional: historical OMM database (time-scrubbing) ───────────────────────
# History is FULLY OPTIONAL. Leave DATABASE_URL unset and the backend behaves
# exactly as before — the /api/history/* routes return 503. Set it to a
# TimescaleDB-enabled Postgres to start accumulating daily orbital history.
# Local dev (see docker-compose.yml at the repo root): `docker compose up -d`
# DATABASE_URL=postgres://orbitwatch:orbitwatch@localhost:5432/orbitwatch
#
# TLS for managed/remote Postgres (Railway external, Timescale Cloud). Unset for
# local docker / internal-network connections.
#   require → TLS, skip cert verification (typical managed PG)
#   verify  → TLS, verify the chain
# HISTORY_DB_SSL=require
#
# Optional: where raw GP snapshots are archived (defaults to <CACHE_DIR>/history/raw).
# Point at a mounted volume to make the raw archive durable across deploys.
# HISTORY_ARCHIVE_DIR=./data/history/raw
#
# Optional: max pooled DB connections (default 8).
# HISTORY_DB_POOL_MAX=8

# ── Optional: Perceptor natural-language → query compiler (/api/query/*) ──────
# Set ONE key; Gemini wins if both are set. With neither, /api/query/* return 503
# and the rest of the app is unaffected.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Model override for the compiler. Defaults: gemini-3.1-flash-lite (Gemini; only
# a value starting with 'gemini' overrides it) / claude-haiku-4-5 (Anthropic).
# ANALYTIC_COMPILER_MODEL=

# ── Optional: catalog compression (/api/tle/all) ─────────────────────────────
# A brotli copy of the catalog is built in the background after each data update
# (about 10 s, +50 MB RAM at quality 10) and served to clients that allow it;
# everyone else still gets the gzip copy. Set TLE_BROTLI=0 to turn brotli off.
# TLE_BROTLI=1
# TLE_BROTLI_QUALITY=10

# ── Optional: alerts ─────────────────────────────────────────────────────────
# When all 5 daily Space-Track attempts fail (the daily limit), the backend writes
# an ERROR line starting with "ALERT" to the log and, if you set one of the options
# below, also tells you. At most one alert per UTC day. Delivery problems are only
# logged; they never stop the update cycle. Nothing here is required.
#
# Webhook: the alert is POSTed to this URL.
# ALERT_WEBHOOK_URL=
# Body format: ntfy (plain text + Title header), slack ({"text"}), discord
# ({"content"}) or json ({"title","body"}, the default).
# ALERT_WEBHOOK_FORMAT=json
#
# Email through Resend (https://resend.com). Sent only when BOTH the key and the
# recipient are set. ALERT_EMAIL_TO may hold several addresses, comma separated.
# ALERT_EMAIL_FROM defaults to Resend's shared test sender, which can only mail
# the address that owns the Resend account; verify a domain to use your own.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=OrbitWatch <onboarding@resend.dev>
